# Copy to .env (gitignored) next to run.sh / run.ps1. Variables already set in your shell win.
# Empty values are prompted for at launch (endpoint and token only). Do not quote or commit real values.
PROXMOX_VE_ENDPOINT=
PROXMOX_VE_API_TOKEN=
GH_TOKEN=
# Optional: path to the age private key on the host
AGE_KEY_FILE=
